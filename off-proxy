#!/usr/bin/env bash
# Project-scoped Docker management. Runtime data never lives in a release folder.
set -Eeuo pipefail

ROOT=${OFF_PROXY_DIR:-/opt/off-proxy-server}
BIN_DIR=${OFF_PROXY_BIN_DIR:-/usr/local/bin}
TEMP=
MAINTENANCE_SOURCE=

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
require_root() { [[ $(id -u) == 0 ]] || die 'Run as root / Als root ausführen.'; }
prerequisites() {
  local tool
  for tool in docker curl tar flock; do command -v "$tool" >/dev/null || die "Missing command: $tool"; done
  docker compose version >/dev/null
}
cleanup() {
  release_maintenance
  if [[ -n $TEMP && $TEMP == "$ROOT"/.stage.* && -d $TEMP ]]; then rm -rf -- "$TEMP"; fi
}
trap cleanup EXIT

validate_root() {
  [[ $ROOT == /* && $ROOT != / && $ROOT != /opt && $ROOT != *$'\n'* ]] || die 'Invalid installation directory.'
}
lock_operation() {
  exec 9>"$ROOT/.state/operation.lock"
  flock -n 9 || die 'Another install/update is running.'
}
load_state() {
  validate_root
  [[ -f $ROOT/.state/managed && -f $ROOT/.env ]] || die 'Not installed. Run install.sh first.'
  RUNTIME=$(cat "$ROOT/.state/runtime")
  PROJECT=$(cat "$ROOT/.state/project")
  [[ $RUNTIME == /* && -d $RUNTIME ]] || die 'Runtime directory unavailable.'
  [[ $PROJECT =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die 'Invalid Compose project name.'
}
source_for() {
  [[ $1 =~ ^[a-f0-9]{40}$ ]] || die 'Invalid saved release identifier.'
  printf '%s/releases/%s' "$ROOT" "$1"
}
current_source() {
  [[ -f $ROOT/.state/current ]] || die 'No active release.'
  source_for "$(cat "$ROOT/.state/current")"
}
version_for() {
  local version
  version=$(cat "$1/VERSION")
  [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(-beta\.[0-9]+)?$ ]] || die 'Invalid source VERSION.'
  printf '%s' "$version"
}
compose_images() {
  local source=$1 image_tag=$2 mongo_image=$3 program=$1/server; shift 3
  OFF_PROXY_SOURCE_DIR=$program OFF_PROXY_IMAGE_TAG=$image_tag OFF_PROXY_MONGO_IMAGE=$mongo_image OFF_PROXY_PYTHON_IMAGE=${PYTHON_IMAGE_OVERRIDE:-python:3.13-slim} \
  OFF_PROXY_PROGRAM_COMMIT=${source##*/} \
    docker compose --project-directory "$RUNTIME" --env-file "$ROOT/.env" \
      -p "$PROJECT" -f "$program/compose.yaml" "$@"
}
image_tag_for() {
  local release
  release=$(basename "$1")
  if [[ -f $ROOT/.state/image-$release ]]; then cat "$ROOT/.state/image-$release"; else printf '%s' "$release"; fi
}
mongo_image() {
  if [[ -f $ROOT/.state/mongo-image ]]; then cat "$ROOT/.state/mongo-image"; else printf 'mongo:8.0'; fi
}
compose_at() {
  local source=$1; shift
  compose_images "$source" "$(image_tag_for "$source")" "$(mongo_image)" "$@"
}
compose_current() { compose_at "$(current_source)" "$@"; }

check_import_idle() {
  local source=$1 result=0 running
  running=$(compose_at "$source" ps --status running -q sync)
  [[ -n $running ]] || return 0
  # shellcheck disable=SC2016 # MongoDB operators must not be expanded by the shell.
  compose_at "$source" exec -T sync python -c '
import os, sys
from pymongo import MongoClient
db=MongoClient(os.environ["MONGO_URI"],serverSelectionTimeoutMS=5000)["off_local"]
busy=[s["_id"] for s in db.state.find({"phase":{"$in":["full_import","delta_import"]}})]
if busy: print("Import active / Import läuft: " + ", ".join(busy), file=sys.stderr)
sys.exit(75 if busy else 0)' || result=$?
  [[ $result == 0 ]] || die 'Update deferred. Wait for the import to finish; nothing restarted.'
}

acquire_maintenance() {
  local source=$1 running
  running=$(compose_at "$source" ps --status running -q sync)
  [[ -n $running ]] || return 0
  # This update gate and the worker's cycle claim share one atomic scheduler row.
  # shellcheck disable=SC2016 # MongoDB operators must not be expanded by the shell.
  compose_at "$source" exec -T sync python -c '
import os, sys, time
from pymongo import MongoClient
db=MongoClient(os.environ["MONGO_URI"],serverSelectionTimeoutMS=5000)["off_local"]
db.scheduler.update_one({"_id":"sync"},{"$setOnInsert":{"phase":"waiting"}},upsert=True)
result=db.scheduler.update_one({"_id":"sync","phase":{"$ne":"running"}},
    {"$set":{"maintenance_until":time.time()+600}})
if not result.matched_count: sys.exit(75)' || die 'Update deferred: synchronization started; nothing stopped.'
  MAINTENANCE_SOURCE=$source
  check_import_idle "$source"
}
release_maintenance() {
  [[ -n $MAINTENANCE_SOURCE ]] || return 0
  # shellcheck disable=SC2016 # MongoDB operators must not be expanded by the shell.
  compose_at "$MAINTENANCE_SOURCE" exec -T sync python -c '
import os
from pymongo import MongoClient
db=MongoClient(os.environ["MONGO_URI"],serverSelectionTimeoutMS=5000)["off_local"]
db.scheduler.update_one({"_id":"sync"},{"$unset":{"maintenance_until":""}})' >/dev/null 2>&1 ||
    printf 'Maintenance gate expires automatically within ten minutes.\n' >&2
  MAINTENANCE_SOURCE=
}

validate_runtime_list() {
  local source=$1 name count=0
  [[ -f $source/runtime-files.txt ]] || return 1
  while IFS= read -r name || [[ -n $name ]]; do
    case "$name" in
      test*|*/*|*..*|'') return 1 ;;
      *.py) [[ $name =~ ^[a-z][a-z0-9_]*\.py$ ]] || return 1 ;;
      compose.yaml|Dockerfile|.dockerignore|requirements.txt|runtime-files.txt) ;;
      *) return 1 ;;
    esac
    [[ -f $source/$name && ! -L $source/$name ]] || return 1
    count=$((count+1))
  done < "$source/runtime-files.txt"
  (( count > 0 ))
}
runtime_complete() {
  local source=$1 program=$1/server name
  [[ ! -L $program && ! -L $program/web ]] || return 1
  validate_runtime_list "$program" || return 1
  for name in VERSION off-proxy; do
    [[ -f $source/$name && ! -L $source/$name ]] || return 1
  done
  for name in app.py compose.yaml Dockerfile .dockerignore requirements.txt runtime-files.txt web/index.html web/dashboard.js web/dashboard.css; do
    [[ -f $program/$name && ! -L $program/$name ]] || return 1
  done
}

fetch_release() {
  local branch=${2:-main}
  [[ $branch == main || $branch == beta ]] || die 'Invalid update branch.'
  TEMP=$(mktemp -d "$ROOT/.stage.XXXXXX")
  if [[ -n ${1:-} ]]; then
    RELEASE=$1
  else
  curl -fsSL --proto '=https' --proto-redir '=https' --retry 2 --connect-timeout 15 --max-time 90 \
    "https://api.github.com/repos/Nisbo/off-proxy-server/commits/$branch" -o "$TEMP/commit.json"
  RELEASE=$(sed -nE '/^[[:space:]]*"sha":/ {s/^[[:space:]]*"sha":[[:space:]]*"([a-f0-9]{40})".*/\1/;p;q;}' "$TEMP/commit.json")
  fi
  [[ $RELEASE =~ ^[a-f0-9]{40}$ ]] || die 'GitHub did not return a valid commit.'
  if ! runtime_complete "$ROOT/releases/$RELEASE"; then
    curl -fsSL --proto '=https' --proto-redir '=https' --retry 2 --connect-timeout 15 --max-time 180 \
      "https://codeload.github.com/Nisbo/off-proxy-server/tar.gz/$RELEASE" -o "$TEMP/source.tar.gz"
    mkdir "$TEMP/source"
    tar -xzf "$TEMP/source.tar.gz" --no-same-owner --no-same-permissions \
      --strip-components=1 -C "$TEMP/source"
    version_for "$TEMP/source" >/dev/null
    local name program="$TEMP/source/server" target="$TEMP/runtime/server"
    runtime_complete "$TEMP/source" || die 'Incomplete or invalid source archive. Existing services unchanged.'
    mkdir -p "$target/web"
    for name in VERSION off-proxy; do
      install -m 644 "$TEMP/source/$name" "$TEMP/runtime/$name"
    done
    while IFS= read -r name || [[ -n $name ]]; do
      install -m 644 "$program/$name" "$target/$name"
    done < "$program/runtime-files.txt"
    for name in index.html dashboard.js dashboard.css; do
      install -m 644 "$program/web/$name" "$target/web/$name"
    done
    # The staging directory is private, while Docker reads code as a non-root user.
    chmod 755 "$target" "$target/web"
    [[ ! -f $TEMP/source/LICENSE ]] || cp -p "$TEMP/source/LICENSE" "$TEMP/runtime/LICENSE"
    runtime_complete "$TEMP/runtime" || die 'Incomplete runtime manifest. Existing services unchanged.'
    # Replace an incomplete cached snapshot only after validating the archive.
    if [[ -d $ROOT/releases/$RELEASE ]]; then mv "$ROOT/releases/$RELEASE" "$TEMP/incomplete-runtime"; fi
    mv "$TEMP/runtime" "$ROOT/releases/$RELEASE"
  fi
  cleanup; TEMP=
}

# Shared client code keeps status, update checks and tests working after key rotation.
API_CLIENT_PY='import json, os, sys, urllib.request, urllib.error
from pymongo import MongoClient
from security import Security
def current_key():
    db=MongoClient(os.environ["MONGO_URI"],serverSelectionTimeoutMS=5000)["off_local"]
    return Security(db,os.environ["API_TOKEN"]).api_key()
'
api_exec() {
  local source=$1 code=$2; shift 2
  compose_at "$source" exec -T api python -c "$API_CLIENT_PY"$'\n'"$code" "$@"
}

wait_api() {
  local source=$1 expected=$2 image_tag=${3:-} mongo_ref=${4:-} _attempt last_error=
  [[ -n $image_tag ]] || image_tag=$(image_tag_for "$source")
  [[ -n $mongo_ref ]] || mongo_ref=$(mongo_image)
  for _attempt in {1..15}; do
    if last_error=$(compose_images "$source" "$image_tag" "$mongo_ref" exec -T api python -c "$API_CLIENT_PY"$'\n''r=urllib.request.Request("http://127.0.0.1:8080/health",headers={"Authorization":"Bearer "+current_key()})
with urllib.request.urlopen(r,timeout=5) as response:
    sys.exit(0 if json.load(response)["version"]==sys.argv[1] else 1)' "$expected" 2>&1); then return 0; fi
    sleep 2
  done
  [[ -z $last_error ]] || printf '%s\n' "$last_error" >&2
  return 1
}

write_pointer() {
  printf '%s\n' "$2" > "$ROOT/.state/$1.new"
  mv "$ROOT/.state/$1.new" "$ROOT/.state/$1"
}
install_command() {
  local source=$1
  if [[ -f $source/off-proxy ]]; then
    install -m 700 "$source/off-proxy" "$ROOT/off-proxy.new"
    mv "$ROOT/off-proxy.new" "$ROOT/off-proxy"
  fi
  [[ -f $ROOT/off-proxy ]] || die 'Management command missing.'
  [[ ${2:-} != host ]] || return 0
  mkdir -p "$BIN_DIR"
  {
    printf '#!/usr/bin/env bash\nexport OFF_PROXY_DIR=%q\nexec %q "$@"\n' "$ROOT" "$ROOT/off-proxy"
  } > "$BIN_DIR/off-proxy.new"
  chmod 700 "$BIN_DIR/off-proxy.new"
  mv "$BIN_DIR/off-proxy.new" "$BIN_DIR/off-proxy"
}

activate() {
  local next=$1 old=${2:-} mode=${3:-} source expected
  source=$(source_for "$next")
  runtime_complete "$source" || die 'Unsupported or incomplete application archive. Existing services unchanged.'
  expected=$(version_for "$source")
  compose_at "$source" config --quiet
  [[ -z $old ]] || check_import_idle "$(source_for "$old")"
  # Build first so a failed download/build cannot stop the existing service.
  if [[ $mode == host ]]; then component_phase downloading; fi
  docker pull python:3.13-slim
  local python_base
  python_base=$(docker image inspect --format '{{index .RepoDigests 0}}' python:3.13-slim)
  [[ $python_base =~ ^python@sha256:[a-f0-9]{64}$ ]] || die 'Cannot identify Python base image.'
  if [[ $mode == host ]]; then component_phase building; fi
  PYTHON_IMAGE_OVERRIDE=$python_base compose_at "$source" build api
  if [[ -n $old ]]; then
    acquire_maintenance "$(source_for "$old")"
    if [[ $mode == host ]]; then component_phase restarting; fi
    compose_at "$(source_for "$old")" stop sync
  fi
  local result=0
  compose_at "$source" up -d --no-build || result=$?
  if [[ $mode == host ]]; then
    compose_at "$source" exec -T sync python components.py phase verifying >/dev/null 2>&1 || true
  fi
  if [[ $result != 0 ]] || ! wait_api "$source" "$expected"; then
    if [[ -n $old ]]; then
      printf 'Activation failed; restoring previous services.\n' >&2
      compose_at "$(source_for "$old")" up -d --no-build || true
    else
      # Prevent a failed first activation from leaving an uncontrolled import.
      compose_at "$source" stop sync || true
    fi
    die 'New API failed to start. Data and credentials retained; inspect Docker logs.'
  fi
  release_maintenance
  [[ -z $old || $next == "$old" ]] || write_pointer previous "$old"
  write_pointer current "$next"
  install_command "$source" "$mode"
  if [[ $mode != host ]]; then install_host_agent; fi
  printf 'OFF Proxy Server %s ready. Delta checks run in the background; confirm full imports in the dashboard.\n' "$expected"
}

resolve_program_release() {
  # A one-off container also works when the installed stack is stopped.
  compose_current run --rm --no-deps -T --entrypoint python api releases.py "$1"
}

update_program() {
  local mode=$1 channel=${2:-} pinned=${3:-} expected=${4:-} old resolved commit version extra
  lock_operation
  old=$(cat "$ROOT/.state/current")
  check_import_idle "$(source_for "$old")"
  if [[ -n $channel ]]; then
    if [[ $mode == host ]]; then component_phase downloading; fi
    resolved=$(resolve_program_release "$channel")
    read -r commit version extra <<< "$resolved"
    [[ $commit =~ ^[a-f0-9]{40}$ && $version =~ ^[0-9]+\.[0-9]+\.[0-9]+(-beta\.[0-9]+)?$ && -z $extra ]] ||
      die 'Invalid published release.'
    if [[ $mode == host && ( $pinned != "$commit" || $expected != "$version" ) ]]; then
      printf 'Published release changed; check for updates again.\n' >&2
      return 76
    fi
    fetch_release "$commit"
    [[ $(version_for "$(source_for "$RELEASE")") == "$version" ]] ||
      die 'Release tag and packaged version differ. Existing services unchanged.'
  else
    fetch_release "" "$mode"
  fi
  if [[ $old == "$RELEASE" ]]; then printf 'Already current.\n'; return; fi
  activate "$RELEASE" "$old" "$mode"
  if [[ $mode != host ]]; then password_setup; fi
}

components_update() {
  local source release old_tag old_mongo mongo_container next_tag next_mongo python_base result=0
  source=$(current_source); release=$(basename "$source")
  check_import_idle "$source"
  old_tag=$(image_tag_for "$source")
  # Pin the actual local database image before pulling its moving 8.0 tag.
  mongo_container=$(compose_at "$source" ps --all -q mongo)
  if [[ -n $mongo_container ]]; then
    old_mongo=$(docker inspect --format '{{.Image}}' "$mongo_container")
  else
    old_mongo=$(docker image inspect --format '{{.Id}}' "$(mongo_image)")
  fi
  [[ $old_mongo =~ ^sha256:[a-f0-9]{64}$ ]] || die 'Cannot identify existing MongoDB image; nothing restarted.'
  write_pointer mongo-image "$old_mongo"
  next_tag="$release-components-$(date +%s)-$RANDOM"
  printf 'Updating components only / Nur Komponenten aktualisieren: Python/Linux, Gunicorn 27.x, MongoDB 8.0.x.\n'
  printf 'Application code and pinned libraries stay unchanged; services restart briefly. No automatic updates.\n'
  printf 'Programmcode und festgelegte Bibliotheken bleiben unverändert; kurzer Neustart. Keine automatischen Updates.\n'
  # Both downloads/builds finish before any service is stopped. Old app tags stay intact.
  component_phase downloading
  docker pull python:3.13-slim
  python_base=$(docker image inspect --format '{{index .RepoDigests 0}}' python:3.13-slim)
  [[ $python_base =~ ^python@sha256:[a-f0-9]{64}$ ]] || die 'Cannot identify Python base image.'
  docker pull mongo:8.0
  next_mongo=$(docker image inspect --format '{{index .RepoDigests 0}}' mongo:8.0)
  [[ $next_mongo =~ ^mongo@sha256:[a-f0-9]{64}$ ]] || die 'Cannot pin downloaded MongoDB image; nothing restarted.'
  component_phase building
  PYTHON_IMAGE_OVERRIDE=$python_base compose_images "$source" "$next_tag" "$next_mongo" build --pull --no-cache api
  acquire_maintenance "$source"
  component_phase restarting
  compose_at "$source" stop sync
  compose_images "$source" "$next_tag" "$next_mongo" up -d --no-build --pull never || result=$?
  component_phase verifying
  if [[ $result != 0 ]] || ! wait_api "$source" "$(version_for "$source")" "$next_tag" "$next_mongo"; then
    printf 'Component activation failed; restoring previous images / Bisherige Images werden wiederhergestellt.\n' >&2
    compose_images "$source" "$next_tag" "$next_mongo" stop sync || true
    compose_images "$source" "$old_tag" "$old_mongo" up -d --no-build --pull never || true
    die 'Component update failed. Data and credentials retained; inspect Docker logs.'
  fi
  write_pointer "image-$release" "$next_tag"
  write_pointer mongo-image "$next_mongo"
  release_maintenance
  component_inventory || true
  printf 'Components updated / Komponenten aktualisiert. Application version / Programmversion: %s\n' "$(version_for "$source")"
}

# The host agent accepts only fixed actions; the web container has no Docker socket.
component_exec() { compose_current exec -T sync python components.py "$@"; }
component_phase() { component_exec phase "$1" >/dev/null 2>&1 || true; }
component_inventory() {
  local app_image app_container mongo_container base mongo
  app_container=$(compose_current ps --all -q api)
  app_image=$(docker inspect --format '{{.Image}}' "$app_container")
  base=$(docker image inspect --format '{{index .Config.Labels "org.off-proxy.python-base"}}' "$app_image")
  mongo_container=$(compose_current ps --all -q mongo)
  mongo=$(docker inspect --format '{{.Image}}' "$mongo_container")
  mongo=$(docker image inspect --format '{{index .RepoDigests 0}}' "$mongo")
  component_exec inventory "$base" "$mongo"
}
agent_unit() {
  printf 'off-proxy-components-%s.service' "$(printf '%s' "$ROOT" | cksum | cut -d' ' -f1)"
}
install_host_agent() {
  local unit service_dir escaped
  [[ ${OFF_PROXY_DISABLE_HOST_AGENT:-0} != 1 ]] || return 0
  command -v systemctl >/dev/null || return 0
  [[ -d /run/systemd/system || ${OFF_PROXY_TEST_SYSTEMD:-} == 1 ]] || {
    printf 'GUI component actions need systemd / GUI-Komponentenaktionen benötigen systemd. CLI remains available.\n'; return 0;
  }
  unit=$(agent_unit)
  service_dir=${OFF_PROXY_SERVICE_DIR:-/etc/systemd/system}
  mkdir -p "$service_dir"
  escaped=${ROOT//\\/\\\\}; escaped=${escaped//\"/\\\"}; escaped=${escaped//%/%%}
  cat > "$service_dir/$unit" <<EOF
[Unit]
Description=OFF Proxy component jobs (explicit user requests only)
After=docker.service
Requires=docker.service
[Service]
Type=simple
Environment="OFF_PROXY_DIR=$escaped"
ExecStart=/usr/bin/env bash "$escaped/off-proxy" components-worker
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths="$escaped"
[Install]
WantedBy=multi-user.target
EOF
  chmod 644 "$service_dir/$unit"
  systemctl daemon-reload && systemctl enable "$unit" && systemctl restart "$unit" ||
    printf 'Host agent could not start; use off-proxy host-agent install / Host-Dienst konnte nicht starten.\n' >&2
}
components_worker() {
  local action job pid result exit_code channel commit version extra ready=0
  exec 8>"$ROOT/.state/agent.lock"
  flock -n 8 || die 'Host agent already running.'
  umask 077
  while :; do
    if ! component_exec heartbeat >/dev/null 2>&1; then sleep 5; continue; fi
    if [[ $ready == 0 ]]; then
      component_exec recover || { sleep 5; continue; }
      component_inventory >/dev/null 2>&1 || true
      ready=1
    fi
    job=$(component_exec claim) || { sleep 5; continue; }
    read -r action channel commit version extra <<< "$job"
    case "$action" in
      check|update|program-update)
        (
          if [[ $action == check ]]; then
            component_inventory && component_exec check
          elif [[ $action == update ]]; then
            "$ROOT/off-proxy" components-update && { component_exec check || true; }
          else
            [[ -z $extra ]] || exit 1
            "$ROOT/off-proxy" program-release-install "$channel" "$commit" "$version"
          fi
        ) >"$ROOT/.state/components.log" 2>&1 &
        pid=$!
        while kill -0 "$pid" 2>/dev/null; do
          sleep 5
          component_exec heartbeat >/dev/null 2>&1 || true
        done
        result=success
        exit_code=0
        wait "$pid" || exit_code=$?
        # Only codes are displayed; raw logs may include operational details.
        if [[ $exit_code == 76 && $action == program-update ]]; then
          result=release_changed
        elif [[ $exit_code != 0 ]]; then
          result=failed
          if grep -q 'Update deferred' "$ROOT/.state/components.log"; then result=deferred; fi
        fi
        until component_exec finish "$result"; do
          sleep 5
          component_exec heartbeat >/dev/null 2>&1 || true
        done
        tail -c 1048576 "$ROOT/.state/components.log" > "$ROOT/.state/components.log.new"
        mv "$ROOT/.state/components.log.new" "$ROOT/.state/components.log"
        if [[ $action == program-update && $result == success ]]; then
          # Persist the result before replacing the process that reports it.
          systemctl --no-block restart "$(agent_unit)" >/dev/null 2>&1 || true
        fi
        ;;
      '') ;;
      *) die 'Invalid component job.' ;;
    esac
    sleep 5
  done
}

prepare_install() {
  validate_root
  if [[ -e $ROOT && ! -f $ROOT/.state/managed ]]; then die "Directory already exists: $ROOT"; fi
  umask 077
  mkdir -p "$ROOT/.state" "$ROOT/releases"
  lock_operation
  if [[ -f $ROOT/.state/managed ]]; then load_state; return; fi
  RUNTIME=$ROOT; PROJECT=off-proxy-server
  if [[ -n $(docker ps -aq --filter label=com.docker.compose.project="$PROJECT") ]]; then
    die 'A Docker project with this name already exists.'
  fi
  local token
  token=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
  printf 'BIND_IP=127.0.0.1\nPORT=8097\nAPI_TOKEN=%s\n' "$token" > "$ROOT/.env"
  mkdir -p "$ROOT/data" "$ROOT/configdb"
  chmod 600 "$ROOT/.env"
  printf '%s\n' "$RUNTIME" > "$ROOT/.state/runtime"
  printf '%s\n' "$PROJECT" > "$ROOT/.state/project"
  printf '1\n' > "$ROOT/.state/managed"
}

status_command() {
  api_exec "$(current_source)" 'r=urllib.request.Request("http://127.0.0.1:8080/health",headers={"Authorization":"Bearer "+current_key()})
with urllib.request.urlopen(r,timeout=10) as response:
    print(json.dumps(json.load(response),ensure_ascii=False,indent=2))'
}
test_command() {
  local code=${1:-4062139025398} kind=${2:-all}
  [[ $code =~ ^[0-9]+$ ]] || die 'Numeric barcode required.'
  [[ $kind =~ ^(food|beauty|petfood|product|all)$ ]] || die 'Invalid product type.'
  api_exec "$(current_source)" 'url="http://127.0.0.1:8080/api/v3/product/"+sys.argv[1]+".json?product_type="+sys.argv[2]+"&fields=code,product_name,product_name_de,product_name_en,brands,quantity,image_front_thumb_url,product_type"
req=urllib.request.Request(url,headers={"Authorization":"Bearer "+current_key()})
try:
    with urllib.request.urlopen(req,timeout=10) as response: print(json.dumps(json.load(response),ensure_ascii=False,indent=2))
except urllib.error.HTTPError as error:
    print(error.code,error.read().decode()); sys.exit(1)' "$code" "$kind"
}

password_command() (
  local first second terminal_state
  (: </dev/tty) 2>/dev/null || die 'A terminal is required / Bitte in einem Terminal ausführen.'
  terminal_state=$(stty -g </dev/tty)
  trap 'stty "$terminal_state" </dev/tty' EXIT
  trap 'exit 130' INT TERM
  stty -echo </dev/tty
  printf 'New GUI password (8–256 characters) / Neues GUI-Passwort (8–256 Zeichen): ' >/dev/tty
  IFS= read -r -s first </dev/tty || die 'Password entry cancelled.'
  printf '\nRepeat password / Passwort wiederholen: ' >/dev/tty
  IFS= read -r -s second </dev/tty || die 'Password entry cancelled.'
  printf '\n' >/dev/tty
  [[ $first == "$second" ]] || die 'Passwords do not match / Passwörter stimmen nicht überein.'
  printf '%s\n' "$first" | compose_current exec -T api python app.py password
  unset first second
)
password_setup() {
  local configured
  configured=$(compose_current exec -T api python app.py password-configured)
  if [[ $configured == no ]]; then
    if [[ ${1:-} == install ]] && (: </dev/tty) 2>/dev/null; then
      password_command
    else
      printf 'GUI locked. Set your password with: off-proxy password / GUI gesperrt. Passwort festlegen: off-proxy password\n'
    fi
  fi
}

main() {
  local action=${1:-help} old next
  if [[ $action == help || $action == --help ]]; then
    printf 'off-proxy update [beta [--head]]|components-update|host-agent install|rollback|start|stop|down|status|logs|password|test [EAN] [type]\n'
    return
  fi
  require_root; prerequisites
  if [[ $action == install ]]; then
    [[ ${OFF_PROXY_BOOTSTRAP_COMMIT:-} =~ ^[a-f0-9]{40}$ ]] || die 'Start installation with install.sh.'
    ROOT=${2:-$ROOT}; prepare_install
    old=$(cat "$ROOT/.state/current" 2>/dev/null || true)
    [[ -z $old ]] || check_import_idle "$(source_for "$old")"
    fetch_release "$OFF_PROXY_BOOTSTRAP_COMMIT"
    if [[ -n ${OFF_PROXY_BOOTSTRAP_VERSION:-} ]]; then
      [[ $(version_for "$(source_for "$RELEASE")") == "$OFF_PROXY_BOOTSTRAP_VERSION" ]] ||
        die 'Release tag and packaged version differ. Existing services unchanged.'
    fi
    if [[ $old == "$RELEASE" ]]; then install_command "$(source_for "$old")"; printf 'Already current.\n'; password_setup install; return; fi
    activate "$RELEASE" "$old"
    password_setup install
    return
  fi
  load_state
  case "$action" in
    update)
      if [[ $# == 1 ]]; then update_program main
      elif [[ $# == 2 && $2 == beta ]]; then update_program release beta
      elif [[ $# == 3 && $2 == beta && $3 == --head ]]; then update_program beta
      else die 'Usage: off-proxy update [beta [--head]]'
      fi ;;
    program-release-install)
      [[ $# == 4 && ( $2 == stable || $2 == beta ) && $3 =~ ^[a-f0-9]{40}$ && $4 =~ ^[0-9]+\.[0-9]+\.[0-9]+(-beta\.[0-9]+)?$ ]] ||
        die 'Invalid program release request.'
      update_program host "$2" "$3" "$4" ;;
    components-update) lock_operation; components_update ;;
    components-worker) components_worker ;;
    host-agent) [[ ${2:-} == install ]] || die 'Usage: off-proxy host-agent install'; install_host_agent ;;
    rollback)
      lock_operation; old=$(cat "$ROOT/.state/current")
      [[ -f $ROOT/.state/previous ]] || die 'No previous release saved.'
      next=$(cat "$ROOT/.state/previous")
      activate "$next" "$old" ;;
    start) lock_operation; compose_current up -d --no-build ;;
    stop) lock_operation; compose_current stop ;;
    down) lock_operation; compose_current down ;;
    password) lock_operation; password_command ;;
    status) status_command ;;
    logs) compose_current logs -f --tail 40 sync ;;
    test) test_command "${2:-4062139025398}" "${3:-all}" ;;
    *) die "Unknown command: $action" ;;
  esac
}
main "$@"
